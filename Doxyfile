PROJECT_NAME           = "DiskoDasko"
OUTPUT_DIRECTORY       = docs
GENERATE_HTML          = YES
HTML_OUTPUT            = html

INPUT                  = src include client/include README.md client/src server/src
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cpp \
                         *.cxx \
                         *.h \
                         *.hpp \
                         *.hh \
                         *.md

RECURSIVE              = YES

USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

# Graphviz (optional, enable only if `dot` is available)
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

INLINE_SOURCES         = YES

GENERATE_LATEX         = NO

# Helpful path trimming (set to your repo root if desired)
STRIP_FROM_PATH        = .
