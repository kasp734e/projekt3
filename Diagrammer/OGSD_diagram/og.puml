@startuml sd-song_playing
title song is playing

actor User
participant "Button Input" as GPIO
participant "Client RPi" as Client
participant "Server RPi" as Server
participant "Sound Control" as Sound
participant "Speaker" as Speaker
participant "LED Matrix" as LED
activate Client

    alt Song is playing
    opt Volume Up
        User ->> GPIO : Press "Volume +"
        activate GPIO
        GPIO ->> Client : GPIO change detected
        deactivate GPIO
        Client ->> Sound : Volume up
        activate Sound
        Sound ->> Speaker : Volume up
        deactivate Sound
    end

    opt Volume Down
        User ->> GPIO : Press "Volume -"
        activate GPIO
        GPIO ->> Client : GPIO change detected
        deactivate GPIO
        Client ->> Sound : Volume down
        activate Sound
        Sound ->> Speaker : Volume down
        deactivate Sound
    end

    opt Pause song
        User ->> GPIO : Press "Pause"
        activate GPIO
        GPIO ->> Client : GPIO change detected
        deactivate GPIO
        Client ->> Sound : Pause song
        activate Sound
        Sound ->> Speaker : Pause song
        deactivate Sound
    end
    opt Skip song
        User ->> GPIO : Press "Skip"
        activate GPIO
        GPIO ->> Client : GPIO change detected
        deactivate GPIO
        Client -> Server : Request next song
        activate Server
        Server --> Client : Send next song
        deactivate Server
    end
    opt Rewind song
        User ->> GPIO : Press "Rewind"
        activate GPIO
        GPIO ->> Client : GPIO change detected
        deactivate GPIO
        Client -> Server : Request previous song
        activate Server
        Server --> Client : Send previous song
        deactivate Server
    end
    opt Shuffle
        User ->> GPIO : Press "Shuffle"
        activate GPIO
        GPIO ->> Client : GPIO change detected
        deactivate GPIO
        Client ->> Server : Shuffle playlist
        activate Server
        Server -> Server : Shuffle playlist
        deactivate Server
    end
end
deactivate Client

@enduml

