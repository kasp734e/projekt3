@startuml sd-systemDiagram
title Music-Light System Sequence Diagram

actor User
participant "Button Input" as GPIO
participant "Client RPi" as Client
participant "Server RPi" as Server
participant "Sound Control" as Sound
participant "Speaker" as Speaker
participant "LED Matrix" as LED


User ->> GPIO : Press "Play"
activate GPIO
GPIO ->> Client : GPIO change detected (Play)
deactivate GPIO

activate Client

loop For each song in playlist
    par Audio Output
        Client ->> Sound : Play song
        activate Sound
        Sound ->> Speaker : Play song
        deactivate Sound
    else Visualizer
        Client ->> LED : Lights on
    end

    alt Song is playing
        note right of Client
              See "Song is playing" sequence diagram
        end note
    else Song is paused
    note right of Client
              See "Song is paused" sequence diagram
        end note
    else Song is done
     Client -> Server : Request next song
    activate Server
    Server --> Client : Send next song
    deactivate Server

    Client -> Client : Perform DSP on audio
end
end

deactivate Client

@enduml

